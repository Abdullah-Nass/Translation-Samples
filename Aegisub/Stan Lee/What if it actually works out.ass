Dialogue: 0,0:00:03.42,0:00:07.78,Default,,0,0,0,,أتدري؟ \N أظن أن بإمكان شخص واحد فعلًا احداث فارق
Dialogue: 0,0:00:09.92,0:00:11.41,Default,,0,0,0,,لا داعي لقول المزيد
Dialogue: 0,0:00:14.53,0:00:16.23,Default,,0,0,0,,تمسك بأوهامك
Dialogue: 0,0:00:16.57,0:00:19.33,Default,,0,0,0,,طُلب مني أن أروي لكم موقفاً طريفاً
Dialogue: 0,0:00:19.33,0:00:21.24,Default,,0,0,0,,المواقف الطريفة سهلة القول
Dialogue: 0,0:00:21.24,0:00:28.83,Default,,0,0,0,,لذلك قلتُ لنفسي: ما نوع القصص التي يمكنني روايتها لأشخاص لديهم بالفعل أمور أكثر أهمية ليشغلوا أنفسهم بها؟
Dialogue: 0,0:00:28.83,0:00:34.11,Default,,0,0,0,,ثم اهتديتُ إلى فكرة أخباركم\N كيف أبصر "الرجل العنكبوت" النور
Dialogue: 0,0:00:37.85,0:00:40.60,Default,,0,0,0,,انها قصة حقيقية
Dialogue: 0,0:00:40.60,0:00:44.42,Default,,0,0,0,,رغم أنه يصعب عليّ أنا نفسي تصديقها أحياناً
Dialogue: 0,0:00:45.52,0:00:48.69,Default,,0,0,0,,« كنا قد انتهينا للتو من سلسلة« الفانتاستك فور
Dialogue: 0,0:00:48.69,0:00:51.67,Default,,0,0,0,,وأظن « الإكس مين » أيضاً؛\N .لا أتذكر الترتيب بالضبط
Dialogue: 0,0:00:51.67,0:00:53.77,Default,,0,0,0,,لكن ناشري جاء إليّ
Dialogue: 0,0:00:53.77,0:00:57.51,Default,,0,0,0,,"وقال: "ستان، أريدك أن تبتكر بطلاً خارقاً جديداً
Dialogue: 0,0:00:58.46,0:01:01.12,Default,,0,0,0,,"فقلتُ له: "حسناً\N وعدتُ إلى المنزل
Dialogue: 0,0:01:01.12,0:01:04.12,Default,,0,0,0,,وعندما يطلب مني الناشر شيء\Nفمن الأفضل أن افعله
Dialogue: 0,0:01:04.12,0:01:06.40,Default,,0,0,0,,لأنني اريد الحفاظ على وظيفتي
Dialogue: 0,0:01:06.40,0:01:11.50,Default,,0,0,0,,فكرت بما يمكنني ابتكاره الآن\Nبينما أهم شيء في البطل الخارق
Dialogue: 0,0:01:11.50,0:01:13.42,Default,,0,0,0,,هو قوته الخارقة
Dialogue: 0,0:01:13.42,0:01:16.61,Default,,0,0,0,,،بمجرد أن تعثر على القوة\N يأتي كل شيء آخر تباعاً
Dialogue: 0,0:01:16.61,0:01:19.61,Default,,0,0,0,,"لذا فكرت: "ما هي القوة التي سأمنحها للشاب الجديد؟
Dialogue: 0,0:01:19.61,0:01:22.99,Default,,0,0,0,,ثم رأيت ذبابة تزحف على الجدار
Dialogue: 0,0:01:22.99,0:01:28.48,Default,,0,0,0,, فقلت في نفسي لو تمكنت من ابتكار بطل خارق\Nيمكنه الالتصاق بالجدران والزحف عليها
Dialogue: 0,0:01:28.48,0:01:30.58,Default,,0,0,0,, !سيكون ذلك أمراً رائعاً
Dialogue: 0,0:01:30.58,0:01:33.58,Default,,0,0,0,,لا، لحظة، أنا أكذب عليكم
Dialogue: 0,0:01:34.64,0:01:38.39,Default,,0,0,0,,(Cool) لا أظن أن كلمة رائع\Nبمفهومها الحالي كانت متداولة حينها
Dialogue: 0,0:01:38.39,0:01:41.39,Default,,0,0,0,,(Groovy) ربما استخدمت تعبير قديم مثل
Dialogue: 0,0:01:42.88,0:01:44.70,Default,,0,0,0,,أنا لا أكذب عليكم أبداً
Dialogue: 0,0:01:45.66,0:01:49.00,Default,,0,0,0,,رأيت أن الفكرة جيدة\Nوالآن كنت بحاجة إلى اسم
Dialogue: 0,0:01:49.35,0:01:54.07,Default,,0,0,0,,فرحتُ أقول: حسناً، لنرى \Nالرجل الذبابة؟ الرجل البعوضة؟
Dialogue: 0,0:01:54.07,0:01:55.82,Default,,0,0,0,,"إلى أن وصلت إلى "الرجل العنكبوت
Dialogue: 0,0:01:55.82,0:01:59.61,Default,,0,0,0,,"الرجل العنكبوت" \Nكان للاسم رنين درامي 
Dialogue: 0,0:01:59.61,0:02:04.04,Default,,0,0,0,,حسناً، ها قد أصبح لدي البطل، وقوته، واسمه
Dialogue: 0,0:02:04.04,0:02:06.33,Default,,0,0,0,,ثم فكرت، من باب التسلية فقط
Dialogue: 0,0:02:06.33,0:02:09.10,Default,,0,0,0,,سأمنحه بعض المشاكل الشخصية
Dialogue: 0,0:02:09.10,0:02:13.09,Default,,0,0,0,,فباستثنائكم أنتم بالطبع\N —حيث تبدو حياتكم مثالية—
Dialogue: 0,0:02:13.09,0:02:16.76,Default,,0,0,0,,فإن معظم البشر لديهم مشاكل شخصية
Dialogue: 0,0:02:16.76,0:02:20.46,Default,,0,0,0,,بعد ذلك، خطرت لي فكرة أن أجعله مراهقاً
Dialogue: 0,0:02:20.46,0:02:25.08,Default,,0,0,0,,لأنه لم يكن هناك أي أبطال خارقين مراهقين\N حسب علمي في ذلك الوقت
Dialogue: 0,0:02:25.08,0:02:30.68,Default,,0,0,0,,وهكذا، متسلحاً بكل هذه التفاصيل\N الرائعة وتلك الأفكار العظيمة
Dialogue: 0,0:02:30.68,0:02:34.58,Default,,0,0,0,,هرعت إلى مكتب الناشر وأخبرته بها
Dialogue: 0,0:02:34.58,0:02:37.58,Default,,0,0,0,,وإليكم ردة فعله.. الرد الذي جابهني به
Dialogue: 0,0:02:38.60,0:02:43.72,Default,,0,0,0,,"!ستان، هذه أسوأ فكرة سمعتها في حياتي"
Dialogue: 0,0:02:43.72,0:02:49.86,Default,,0,0,0,,،وبدأ يسرد عليّ أسبابه\N فقد كان رجلاً عقلانياً جداً ومثقفاً للغاية
Dialogue: 0,0:02:50.36,0:02:53.49,Default,,0,0,0,,،أولاً وقبل كل شيء\N الناس يكرهون العناكب
Dialogue: 0,0:02:53.49,0:02:56.49,Default,,0,0,0,,"فلا يمكنك تسمية بطل بـ "الرجل العنكبوت
Dialogue: 0,0:02:57.53,0:03:00.53,Default,,0,0,0,,وتريده أن يكون مراهقاً؟
Dialogue: 0,0:03:00.53,0:03:04.25,Default,,0,0,0,,المراهقون لا يصلحون إلا\N!ليكونوا شخصيات ثانوية
Dialogue: 0,0:03:04.25,0:03:07.60,Default,,0,0,0,,وتريد أن تكون لديه مشاكل شخصية؟
Dialogue: 0,0:03:07.60,0:03:10.86,Default,,0,0,0,,ستان، ألا تعرف ما هو البطل الخارق؟
Dialogue: 0,0:03:10.86,0:03:13.45,Default,,0,0,0,,!ليس لديهم مشاكل شخصية
Dialogue: 0,0:03:13.45,0:03:16.87,Default,,0,0,0,,حسناً، غادرتُ المكتب محبطاً
Dialogue: 0,0:03:16.87,0:03:20.51,Default,,0,0,0,,لكنني أصبحتُ رجلاً أكثر حكمة بكل تأكيد
Dialogue: 0,0:03:21.02,0:03:24.44,Default,,0,0,0,,لم أستطع إخراج "الرجل العنكبوت" من رأسي
Dialogue: 0,0:03:25.04,0:03:29.94,Default,,0,0,0,,وفي تلك الفترة، كنا على وشك إيقاف إصدار مجلة\N"أظن اسمها كان "أمايزينغ فانتسي
Dialogue: 0,0:03:29.94,0:03:31.82,Default,,0,0,0,,لم تكن مبيعاتها جيدة
Dialogue: 0,0:03:31.82,0:03:34.82,Default,,0,0,0,,وكنا بصدد إرسال العدد الأخير إلى المطبعة
Dialogue: 0,0:03:34.82,0:03:39.84,Default,,0,0,0,,،وحين تطبع العدد الأخير من مجلة ما\N لا أحد يهتم بما تضعه فيها
Dialogue: 0,0:03:39.84,0:03:41.91,Default,,0,0,0,,لأن المجلة تلفظ أنفاسها الأخيرة
Dialogue: 0,0:03:41.91,0:03:44.48,Default,,0,0,0,,ولأخرج الفكرة من رأسي
Dialogue: 0,0:03:44.48,0:03:48.00,Default,,0,0,0,,وضعتُ "الرجل العنكبوت" في المجلة
Dialogue: 0,0:03:48.00,0:03:50.18,Default,,0,0,0,,وجعلته نجم الغلاف
Dialogue: 0,0:03:50.18,0:03:51.64,Default,,0,0,0,,.ثم نسيت الأمر تماماً
Dialogue: 0,0:03:51.64,0:03:55.01,Default,,0,0,0,,وبعد شهر، ظهرت أرقام المبيعات
Dialogue: 0,0:03:55.33,0:03:59.02,Default,,0,0,0,,،جاء ناشري يركض متلهفاً إلى مكتبي 
Dialogue: 0,0:03:59.02,0:04:00.54,Default,,0,0,0,,،وهو يصيح: "ستان، ستان
Dialogue: 0,0:04:00.54,0:04:05.23,Default,,0,0,0,,هل تتذكر تلك الشخصية التي\N أحببناها كثيراً.. "الرجل العنكبوت"؟
Dialogue: 0,0:04:07.09,0:04:09.36,Default,,0,0,0,,"!لنصنع منها سلسلة
Dialogue: 0,0:04:10.03,0:04:12.42,Default,,0,0,0,,والآن، لماذا أروي لكم هذا كله
Dialogue: 0,0:04:12.42,0:04:15.86,Default,,0,0,0,,بعيدًا عن رغبتي في تضييع بعض الوقت
Dialogue: 0,0:04:18.31,0:04:23.89,Default,,0,0,0,,إذا كانت لديك فكرة تؤمن بصدق أنها جيدة
Dialogue: 0,0:04:37.58,0:04:43.52,Default,,0,0,0,,هذا لا يعني بالطبع أن كل شطحة خيال\Nأو فكرة غريبة تخطر ببالك ستكون عبقرية
Dialogue: 0,0:04:43.52,0:04:47.27,Default,,0,0,0,,ولكن إذا كان هناك شيء تشعر حقاً أنه جيد
Dialogue: 0,0:04:47.27,0:04:49.45,Default,,0,0,0,,شيء ترغب في إنجازه
Dialogue: 0,0:04:49.45,0:04:52.45,Default,,0,0,0,,شيء يعني لك 
Dialogue: 0,0:04:52.45,0:04:53.91,Default,,0,0,0,,فحاول أن تفعله
Dialogue: 0,0:04:54.09,0:04:58.20,Default,,0,0,0,,لأنني أرى أنك لن تبدع وتقدم أفضل ما لديك 
Dialogue: 0,0:04:58.20,0:05:01.20,Default,,0,0,0,,إلا إذا كنت تفعل ما تحبه بالفعل
Dialogue: 0,0:05:01.20,0:05:04.79,Default,,0,0,0,,وبالطريقة التي تراها صحيحة
Dialogue: 0,0:05:05.32,0:05:08.32,Default,,0,0,0,,وتشعر بالفخر بعد إنجازه
Dialogue: 0,0:05:08.53,0:05:10.24,Default,,0,0,0,,ومهما كان هذا الشيء
Dialogue: 0,0:05:10.24,0:05:13.84,Default,,0,0,0,,ستتمكن من النظر إليه والقول:\N"أنا من صنع هذا، وأعتقد أنه رائع بحق"
Dialogue: 0,0:05:13.84,0:05:15.30,Default,,0,0,0,,. إنه شعور عظيم
Dialogue: 0,0:05:15.30,0:05:17.22,wb,,0,0,0,,أنا ستان لي
Dialogue: 0,0:05:17.22,0:05:22.99,wb,,0,0,0,,أكتب قصصاً للجيل الشاب منذ ثلاثين عام
Dialogue: 0,0:05:23.36,0:05:28.92,wb,,0,0,0,,،وخلال هذه الفترة\Nأظن أنني تعلمت الكثير عن طريقة تفكير الشباب
Dialogue: 0,0:05:28.92,0:05:33.56,wb,,0,0,0,,،بل والأهم من ذلك\Nأظن أنني فهمت جيداً حقيقة الشباب وجوهرهم
Dialogue: 0,0:05:33.56,0:05:38.24,wb,,0,0,0,,سوف نحاول تقديم صوتٍ يجدُ من يُصغي إليه
Dialogue: 0,0:05:38.24,0:05:42.14,wb,,0,0,0,,،فهناك حاجة ماسة لهذا الصوت\Nونتمنى أن يكون صوتنا هو ذلك الصوت
Dialogue: 0,0:04:24.61,0:04:27.98,Default,,0,0,0,,.فلا تدع أحمقاً يثنيك عنها
